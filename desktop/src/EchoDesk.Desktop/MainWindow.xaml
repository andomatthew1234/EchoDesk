<Window x:Class="EchoDesk.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EchoDesk.Desktop.ViewModels"
        Title="EchoDesk Desktop" Width="1080" Height="720" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterScreen" Icon="Assets/echodesk-logo.png">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="Padding" Value="14,11"/>
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,14,20">
                    <Image Source="Assets/echodesk-logo.png" Width="34" Height="34" Stretch="Uniform"/>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource NavText}" Margin="0" FontSize="17" FontWeight="SemiBold" Text="EchoDesk"/>
                        <TextBlock Style="{StaticResource NavText}" Margin="0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="DESKTOP 0.2.5"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,8,14,18">
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Style="{StaticResource NavText}" Text="{Binding ConnectionLabel}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource NavText}" Text="{Binding State.Port, TargetNullValue=Waiting…}" Margin="22,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,4">
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Overview">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="18" Text="&#xE80F;"/><TextBlock Style="{StaticResource NavText}" Text="Overview"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Device Control">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="18" Text="&#xE8D7;"/><TextBlock Style="{StaticResource NavText}" Text="Device Control"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Customisation">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="18" Text="&#xE713;"/><TextBlock Style="{StaticResource NavText}" Text="Customisation"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Set up a new device">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="18" Text="&#xE710;"/><TextBlock Style="{StaticResource NavText}" Text="Set up a new device"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Setup &amp; Updates">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="18" Text="&#xE895;"/><TextBlock Style="{StaticResource NavText}" Text="Setup &amp; Updates"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid Margin="32,26,32,18">
                <!-- Overview -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsOverview, Converter={StaticResource BoolVisibility}}">
                    <StackPanel MaxWidth="1050">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Overview"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Your EchoDesk, at a glance." Margin="0,0,0,24"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource WarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding ConnectionLabel}" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DeviceName}" FontSize="26" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding ConnectionDetail}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding ReconnectCommand}" Content="Reconnect" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Content="Refresh"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="3" Margin="0,0,0,18">
                            <Border Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Style="{StaticResource Muted}" Text="FIRMWARE" FontSize="11"/><TextBlock Text="{Binding Firmware}" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="9,0"><StackPanel><TextBlock Style="{StaticResource Muted}" Text="HARDWARE" FontSize="11"/><TextBlock Text="{Binding Hardware}" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="9,0,0,0"><StackPanel><TextBlock Style="{StaticResource Muted}" Text="ACTIVE APP" FontSize="11"/><TextBlock Text="{Binding ActiveApp}" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                        </UniformGrid>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Components"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="AI Usage Monitor" FontSize="17" FontWeight="SemiBold"/>
                                        <Border Margin="12,0,0,0" Padding="8,3" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AiUsageEnabled}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding AiUsageNeedsAttention}" Value="True"><Setter Property="Fill" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding AiUsageStatus}" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding AiUsageGuidance}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock Margin="0,8,0,0" FontSize="12">
                                        <Run Foreground="{DynamicResource MutedTextBrush}" Text="Last successful update: "/><Run Text="{Binding AiUsageLastUpdated, Mode=OneWay}"/>
                                    </TextBlock>
                                    <ProgressBar Height="3" Margin="0,12,0,0" IsIndeterminate="True" Visibility="{Binding AiUsageFetching, Converter={StaticResource BoolVisibility}}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Top" Content="Enabled" IsChecked="{Binding AiUsageEnabled, Mode=OneWay}"
                                          IsEnabled="{Binding AiUsageAvailable}" Command="{Binding ToggleAiUsageCommand}"/>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Quick actions"/>
                        <ItemsControl ItemsSource="{Binding AppTiles}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AppTile}">
                                    <Button Command="{Binding DataContext.OpenAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Margin="0,0,10,10" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="18" Width="30"/><TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Device Control -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDeviceControl, Converter={StaticResource BoolVisibility}}">
                    <StackPanel MaxWidth="1050">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Device Control"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Open an app on the physical touchscreen." Margin="0,0,0,24"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Apps"/>
                                <ItemsControl ItemsSource="{Binding AppTiles}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:AppTile}">
                                        <Button Command="{Binding DataContext.OpenAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Margin="0,0,10,10" MinHeight="54" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="20" Width="38"/><TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Restart EchoDesk" FontWeight="SemiBold" FontSize="16"/><TextBlock Style="{StaticResource Muted}" Text="The USB connection will briefly disconnect and recover automatically." Margin="0,5,20,0"/></StackPanel>
                                    <Button Grid.Column="1" Content="Restart…" Click="Restart_Click" Background="{DynamicResource DangerBrush}" Foreground="White" IsEnabled="{Binding IsConnected}"/>
                                </Grid>
                                <Separator Margin="0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Factory Reset" FontWeight="SemiBold" FontSize="16"/><TextBlock Style="{StaticResource Muted}" Text="Clear setup completion and return the physical device to its Hello screen. Firmware and unrelated flash partitions are not erased." Margin="0,5,20,0" TextWrapping="Wrap"/></StackPanel>
                                    <Button Grid.Column="1" Content="Factory Reset…" Click="FactoryReset_Click" Background="{DynamicResource DangerBrush}" Foreground="White" IsEnabled="{Binding IsConnected}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Guided device setup. The selected port is pinned by the view model before any write starts. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsGuidedSetup, Converter={StaticResource BoolVisibility}}">
                    <StackPanel MaxWidth="900">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Set up a new device"/>
                        <TextBlock Style="{StaticResource Muted}" Text="A guided, verified installation for EchoDesk Mini." Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}" Padding="18,13" Margin="0,0,0,18">
                            <UniformGrid Columns="5">
                                <StackPanel HorizontalAlignment="Center"><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Terms" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel HorizontalAlignment="Center"><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SurfaceAltBrush}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Connect" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel HorizontalAlignment="Center"><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SurfaceAltBrush}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Choose" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel HorizontalAlignment="Center"><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SurfaceAltBrush}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Install" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel HorizontalAlignment="Center"><Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SurfaceAltBrush}"><TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Ready" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                            </UniformGrid>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding IsGuidedTermsStep, Converter={StaticResource BoolVisibility}}">
                            <StackPanel MaxWidth="690">
                                <TextBlock Text="Before we begin." FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Please review and accept the EchoDesk Terms and Conditions before setting up your device." TextWrapping="Wrap" Margin="0,8,0,18"/>
                                <UniformGrid Columns="3" Margin="0,0,0,14">
                                    <Button Command="{Binding OpenSetupDocumentCommand}" CommandParameter="terms" Margin="0,0,8,0" Padding="12"><StackPanel><TextBlock Text="Terms and Conditions" FontWeight="SemiBold"/><TextBlock Text="Required document" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/></StackPanel></Button>
                                    <Button Command="{Binding OpenSetupDocumentCommand}" CommandParameter="privacy" Margin="4,0" Padding="12"><StackPanel><TextBlock Text="Privacy Policy" FontWeight="SemiBold"/><TextBlock Text="Required document" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/></StackPanel></Button>
                                    <Button Command="{Binding OpenSetupDocumentCommand}" CommandParameter="notices" Margin="8,0,0,0" Padding="12"><StackPanel><TextBlock Text="Third-party notices" FontWeight="SemiBold"/><TextBlock Text="Licences and notices" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/></StackPanel></Button>
                                </UniformGrid>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding GuidedSetupLegalStatus}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/>
                                </Border>
                                <CheckBox IsChecked="{Binding GuidedSetupTermsAccepted}" IsEnabled="{Binding GuidedSetupHasLegalDocuments}" Content="I have read and agree to the EchoDesk Terms and Conditions." Margin="0,0,0,18"/>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding GuidedSetupContinueCommand}" Content="Continue" HorizontalAlignment="Right" MinWidth="110"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding IsGuidedConnectStep, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <TextBlock Text="How do you want to set up EchoDesk?" FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Muted}" Text="USB is the recommended default. Wi-Fi setup is optional and starts only when you choose it." TextWrapping="Wrap" Margin="0,7,0,18"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="10" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="&#xE88E;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="Set up with USB" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
                                            <TextBlock Text="Plug EchoDesk into this PC. The app verifies the device, installs EchoDesk OS and keeps the existing USB workflow unchanged." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MinHeight="65"/>
                                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding GuidedSetupChooseTransportCommand}" CommandParameter="usb" Content="Continue with USB" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="Set up with Wi-Fi" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
                                            <TextBlock Text="Use the temporary network shown on EchoDesk to send your home Wi-Fi details. Windows may disconnect from the internet briefly." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MinHeight="65"/>
                                            <Button Command="{Binding GuidedSetupChooseTransportCommand}" CommandParameter="wifi" Content="Setup with Wi-Fi" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Button Command="{Binding GuidedSetupBackCommand}" Content="Back" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding IsGuidedUsbSelectStep, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Select your EchoDesk." FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Choose the device you'd like to set up. Compatible devices refresh automatically." TextWrapping="Wrap" Margin="0,7,0,16"/>
                                <ListBox ItemsSource="{Binding GuidedSetupDevices}" SelectedValuePath="Port" SelectedValue="{Binding GuidedSetupSelectedPort}" BorderThickness="0" Background="Transparent" MinHeight="110">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding HardwareModel, TargetNullValue=Unidentified serial device — confirmation required}" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding FirmwareVersion, StringFormat=EchoDesk OS {0}, TargetNullValue=Firmware version unavailable}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Port}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="No compatible EchoDesk Mini detected yet. Checking again…" Foreground="{DynamicResource MutedTextBrush}" Margin="2,8,0,10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GuidedSetupHasDevices}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <Expander Header="Having trouble finding your device?" Margin="0,6,0,16"><TextBlock Text="Reconnect the USB cable, try another data-capable cable or USB port, and close any serial terminal. Windows should show a serial device. Setup never asks you to type a COM port." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="4,9,4,4"/></Expander>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="{Binding GuidedSetupRequiresBoardConfirmation, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="This USB serial adapter cannot identify the attached board by itself. Check the label on the physical device before continuing." TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <CheckBox IsChecked="{Binding GuidedSetupBoardConfirmed}" Content="I confirm this physical device is an EchoDesk Mini (Freenove FNK0114A_2P4)."/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding GuidedSetupDeviceDetails}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <StackPanel Orientation="Horizontal"><Button Command="{Binding GuidedSetupBackCommand}" Content="Back" Margin="0,0,8,0"/><Button Command="{Binding GuidedSetupRefreshCommand}" Content="Refresh now" Margin="0,0,8,0"/><Button Style="{StaticResource PrimaryButton}" Command="{Binding GuidedSetupContinueCommand}" Content="Set up this device"/></StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding IsGuidedWifiSelectStep, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Connect through the temporary EchoDesk network." FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Muted}" Text="On EchoDesk, choose Setup with Wi-Fi. It will show a network named EchoDesk-XXXX and an 8-digit code. Open Windows Wi-Fi settings and join that temporary network using the code shown. Then return here and find the device. EchoDesk Desktop never changes Windows networks automatically." TextWrapping="Wrap" Margin="0,7,0,14"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Command="{Binding OpenWindowsWifiSettingsCommand}" Content="Open Windows Wi-Fi settings" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding GuidedSetupRefreshCommand}" Content="Find Wi-Fi devices"/>
                                </StackPanel>
                                <ProgressBar Height="5" IsIndeterminate="True" Margin="0,0,0,12" Visibility="{Binding WifiSetupBusy, Converter={StaticResource BoolVisibility}}"/>
                                <TextBlock Text="{Binding GuidedWifiStatus}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <ListBox ItemsSource="{Binding GuidedWifiDevices}" SelectedValuePath="DeviceId" SelectedValue="{Binding GuidedWifiSelectedDeviceId}" BorderThickness="0" Background="Transparent" MinHeight="80">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding SetupSsid, TargetNullValue=Temporary setup network}" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Address}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="No EchoDesk setup device found. Confirm this PC is joined to the temporary EchoDesk-XXXX network, then select Find Wi-Fi devices." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,8,0,14"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GuidedWifiHasDevices}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <Grid Margin="0,4,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="8-digit setup code" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox Text="{Binding GuidedWifiSetupCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="8"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Home Wi-Fi name (SSID)" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox Text="{Binding GuidedWifiSsid, UpdateSourceTrigger=PropertyChanged}" MaxLength="32"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Home Wi-Fi password" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <PasswordBox x:Name="GuidedWifiPasswordBox" PasswordChanged="GuidedWifiPassword_Changed" MaxLength="63" Margin="0,0,0,6"/>
                                <TextBlock Text="Leave blank only for an open network. WPA2 passwords must be 8–63 characters." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,14"/>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="{Binding GuidedSetupHasError, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding GuidedSetupError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/></Border>
                                <StackPanel Orientation="Horizontal"><Button Command="{Binding GuidedSetupBackCommand}" Content="Back" Margin="0,0,8,0"/><Button Style="{StaticResource PrimaryButton}" Command="{Binding GuidedWifiProvisionCommand}" Content="Connect EchoDesk to Wi-Fi"/></StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding IsGuidedUsbInstallStep, Converter={StaticResource BoolVisibility}}">
                            <StackPanel MaxWidth="690">
                                <TextBlock Text="Installing EchoDesk OS." FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Sit tight. We're getting your EchoDesk ready. Keep the USB cable connected." TextWrapping="Wrap" Margin="0,7,0,18"/>
                                <TextBlock Text="{Binding GuidedSetupProgressLabel}" FontSize="17" FontWeight="SemiBold"/>
                                <ProgressBar Height="9" Minimum="0" Maximum="100" Value="{Binding FirmwareManager.ProgressPercent}" Margin="0,10,0,7" Visibility="{Binding FirmwareHasMeasuredProgress, Converter={StaticResource BoolVisibility}}"/>
                                <ProgressBar Height="9" IsIndeterminate="True" Margin="0,10,0,7" Visibility="{Binding FirmwareHasNoMeasuredProgress, Converter={StaticResource BoolVisibility}}"/>
                                <TextBlock Text="{Binding FirmwareOperationMessage}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,14"><TextBlock Text="The screen may go blank and the serial connection may disappear temporarily while the device restarts. This is expected." TextWrapping="Wrap"/></Border>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="{Binding GuidedSetupHasError, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding GuidedSetupError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/></Border>
                                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Command="{Binding GuidedSetupRetryCommand}" Content="Try again" Margin="0,0,8,0"/><Button Command="{Binding GuidedSetupCancelCommand}" Content="Cancel safely"/></StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding IsGuidedWifiInstallStep, Converter={StaticResource BoolVisibility}}">
                            <StackPanel MaxWidth="690">
                                <TextBlock Text="Connecting EchoDesk to Wi-Fi." FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Keep this computer joined to the temporary EchoDesk network while the device validates and saves the network details." TextWrapping="Wrap" Margin="0,7,0,18"/>
                                <ProgressBar Height="9" IsIndeterminate="True" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding GuidedWifiStatus}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,14"><TextBlock Text="When setup succeeds, EchoDesk restarts and the temporary network disappears. Reconnect this computer to the same home network as EchoDesk before discovering it again." TextWrapping="Wrap"/></Border>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="{Binding GuidedSetupHasError, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding GuidedSetupError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/></Border>
                                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Command="{Binding GuidedSetupRetryCommand}" Content="Try again" Margin="0,0,8,0"/><Button Command="{Binding GuidedSetupCancelCommand}" Content="Cancel safely"/></StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding IsGuidedCompleteStep, Converter={StaticResource BoolVisibility}}">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="620" Margin="28">
                                <Border Width="70" Height="70" CornerRadius="35" Background="{DynamicResource SuccessBrush}"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock Text="{Binding GuidedSetupCompleteHeading}" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" Margin="0,18,0,7"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding GuidedSetupCompleteMessage}" TextAlignment="Center" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,0" Visibility="{Binding GuidedSetupUsesWifi, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GuidedWifiConfirmationStatus}" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <Button Command="{Binding GuidedSetupRefreshCommand}" Content="Find Wi-Fi devices" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding FinishGuidedSetupCommand}" Content="Open EchoDesk Desktop" Margin="0,24,0,0" MinWidth="190"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Setup and Updates -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSetupUpdates, Converter={StaticResource BoolVisibility}}">
                    <StackPanel MaxWidth="1050">
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="Setup &amp; Updates"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Install, update or recover EchoDesk OS without command-line tools."/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ScanFirmwareDevicesCommand}" Content="Scan for devices" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Screen 1: Connect EchoDesk -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding IsFirmwareConnectScreen, Converter={StaticResource BoolVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid Width="190" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="145" Height="106" CornerRadius="13" Background="#16191F" BorderBrush="#687180" BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <Grid><TextBlock Text="ECHO&#x0a;DESK" Foreground="White" FontSize="22" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/></Grid>
                                    </Border>
                                    <Path Data="M 95,106 L 95,145 C 95,158 125,158 125,145" Stroke="{DynamicResource AccentBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Border Width="31" Height="13" CornerRadius="4" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,42,4"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="28,0,0,0">
                                    <TextBlock Text="{Binding FirmwareConnectionHeading}" FontSize="23" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding FirmwareConnectionMessage}" TextWrapping="Wrap" Margin="0,8,0,18"/>
                                    <TextBlock Text="Detected serial devices" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                    <ComboBox ItemsSource="{Binding FirmwareDevices}" ItemTemplate="{StaticResource ComboSummaryTemplate}" SelectedValuePath="Port"
                                              SelectedValue="{Binding SelectedFirmwarePort}" MinWidth="340" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding FirmwareDeviceDetails}" Margin="0,7,0,0"/>
                                    <StackPanel Visibility="{Binding ShowBoardConfirmation, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0">
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="Manual hardware confirmation required" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource Muted}" Text="CH340 is a generic adapter and does not identify the board. Check the label and physical hardware before continuing." TextWrapping="Wrap" Margin="0,5,0,9"/>
                                                <ComboBox ItemsSource="{Binding FirmwareHardwareOptions}" ItemTemplate="{StaticResource ComboLabelTemplate}" SelectedValuePath="Value"
                                                          SelectedValue="{Binding SelectedFirmwareHardwareModel}" Margin="0,0,0,9"/>
                                                <CheckBox IsChecked="{Binding FirmwareBoardConfirmed}" Content="I confirm this is a Freenove FNK0114A_2P4 EchoDesk Mini"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SelectFirmwareDeviceCommand}" Content="Use this device" Margin="0,0,8,0"/>
                                        <Button Command="{Binding ScanFirmwareDevicesCommand}" Content="Scan again"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Recovery" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource Muted}" Text="If normal identification fails, Manual Recovery can reinstall the bundled OS after verifying only that this port is an original ESP32." TextWrapping="Wrap" Margin="0,5,0,9"/>
                                            <Button Content="Manual Recovery…" Tag="manualRecovery" Click="FirmwareAction_Click" IsEnabled="{Binding CanStartManualRecovery}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Screen 2: Ready to install / update -->
                        <StackPanel Visibility="{Binding IsFirmwareReadyScreen, Converter={StaticResource BoolVisibility}}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="EchoDesk Mini is ready" FontSize="23" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="The ESP32 and firmware package have been checked. EchoDesk Desktop will release the serial port before writing and reconnect afterwards." TextWrapping="Wrap" Margin="0,7,0,18"/>
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Muted}" Text="DEVICE" FontSize="11"/><TextBlock Text="EchoDesk Mini" FontWeight="SemiBold" FontSize="16" Margin="0,6,0,0"/></StackPanel>
                                        <StackPanel Margin="12,0"><TextBlock Style="{StaticResource Muted}" Text="CURRENT VERSION" FontSize="11"/><TextBlock Text="{Binding FirmwareCurrentVersion}" FontWeight="SemiBold" FontSize="16" Margin="0,6,0,0"/></StackPanel>
                                        <StackPanel Margin="12,0,0,0"><TextBlock Style="{StaticResource Muted}" Text="AVAILABLE VERSION" FontSize="11"/><TextBlock Text="{Binding FirmwareAvailableVersion}" FontWeight="SemiBold" FontSize="16" Margin="0,6,0,0"/></StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="What happens"/>
                                    <TextBlock Text="1  Verify firmware    2  Enter bootloader    3  Write and verify    4  Restart and reconnect" TextWrapping="Wrap"/>
                                    <TextBlock Foreground="{DynamicResource WarningBrush}" Text="A repair or reinstall may reset device settings. EchoDesk will preserve and restore supported settings where available. Do not unplug the USB cable." TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource SectionTitle}" Text="Release notes"/><Button Grid.Column="1" Command="{Binding CheckFirmwareUpdatesCommand}" Content="Check for updates"/></Grid>
                                    <TextBlock Text="{Binding FirmwareReleaseNotes}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                                    <CheckBox IsChecked="{Binding UpdateNotificationsEnabled, Mode=OneWay}" Command="{Binding ToggleUpdateNotificationsCommand}" Content="Notify me when EchoDesk OS updates are available"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Install EchoDesk OS" Tag="install" Click="FirmwareAction_Click" Margin="0,0,8,0"/>
                                <Button Content="Install update" Tag="update" Click="FirmwareAction_Click" Margin="0,0,8,0" IsEnabled="{Binding FirmwareUpdateAvailable}"/>
                                <Button Content="Reinstall current version" Tag="reinstall" Click="FirmwareAction_Click" Margin="0,0,8,0"/>
                                <Button Content="Repair device…" Tag="repair" Click="FirmwareAction_Click" Margin="0,0,8,0"/>
                                <Button Content="Manual Recovery…" Tag="manualRecovery" Click="FirmwareAction_Click" IsEnabled="{Binding CanStartManualRecovery}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Screen 3: Installing. Percentage is shown only when reported by the flashing engine. -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding IsFirmwareInstallingScreen, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Installing EchoDesk OS" FontSize="23" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding FirmwareStageLabel}" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,3"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding FirmwareOperationMessage}" TextWrapping="Wrap"/>
                                <ProgressBar Height="8" Margin="0,20,0,7" Minimum="0" Maximum="100" Value="{Binding FirmwareManager.ProgressPercent}"
                                             Visibility="{Binding FirmwareHasMeasuredProgress, Converter={StaticResource BoolVisibility}}"/>
                                <ProgressBar Height="8" Margin="0,20,0,7" IsIndeterminate="True"
                                             Visibility="{Binding FirmwareHasNoMeasuredProgress, Converter={StaticResource BoolVisibility}}"/>
                                <TextBlock Text="{Binding FirmwareProgressLabel}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                <Border Background="#FFF6DD" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                                    <TextBlock Foreground="#6B4A00" Text="Keep the device connected and prevent Windows from sleeping until EchoDesk reconnects." TextWrapping="Wrap"/>
                                </Border>
                                <Button Command="{Binding CancelFirmwareOperationCommand}" Content="Cancel safely" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Screen 4: Success -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding IsFirmwareSuccessScreen, Converter={StaticResource BoolVisibility}}">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="620" Margin="30">
                                <Border Width="66" Height="66" CornerRadius="33" Background="{DynamicResource SuccessBrush}"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock Text="EchoDesk is ready!" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                                <TextBlock Style="{StaticResource Muted}" Text="EchoDesk OS was written, verified, restarted and reconnected successfully." TextAlignment="Center" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="Overview" Content="Go to Overview" Margin="0,0,8,0"/>
                                    <Button Command="{Binding NavigateCommand}" CommandParameter="Device Control" Content="Open EchoDesk Desktop" Margin="0,0,8,0"/>
                                    <Button Command="{Binding NavigateCommand}" CommandParameter="Customisation" Content="Customise device"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- A completed write without a verified reboot is deliberately not called success. -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding IsFirmwarePartialScreen, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Firmware written — connection not confirmed" FontSize="23" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Muted}" Text="The flash operation completed, but EchoDesk OS did not reconnect. Unplug and reconnect USB, then scan again. Use Repair only if it still cannot connect." TextWrapping="Wrap" Margin="0,8,0,18"/>
                                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanFirmwareDevicesCommand}" Content="Scan again" Margin="0,0,8,0"/><Button Content="Repair device…" Tag="repair" Click="FirmwareAction_Click" Margin="0,0,8,0"/><Button Content="Manual Recovery…" Tag="manualRecovery" Click="FirmwareAction_Click" IsEnabled="{Binding CanStartManualRecovery}"/></StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding IsFirmwareFailureScreen, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <TextBlock Text="EchoDesk OS was not installed" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding FirmwareErrorMessage}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                <TextBlock Text="No completed operation is reported as successful. Reconnect the USB cable, close serial terminals, then scan again. If Windows or antivirus blocked the flashing engine, allow the signed EchoDesk component and retry once." TextWrapping="Wrap" Margin="0,0,0,18"/>
                                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanFirmwareDevicesCommand}" Content="Try detection again" Margin="0,0,8,0"/><Button Content="Repair device…" Tag="repair" Click="FirmwareAction_Click" Margin="0,0,8,0"/><Button Content="Manual Recovery…" Tag="manualRecovery" Click="FirmwareAction_Click" IsEnabled="{Binding CanStartManualRecovery}"/></StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Customisation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCustomisation, Converter={StaticResource BoolVisibility}}">
                    <StackPanel MaxWidth="1050">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Customisation"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Every enabled control writes to the physical EchoDesk and waits for confirmation." Margin="0,0,0,24"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel IsEnabled="{Binding SupportsSettings}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="General"/>
                                <TextBlock Text="Device appearance" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,18">
                                    <Button Command="{Binding SetThemeCommand}" CommandParameter="light" Content="Light" Width="110" Margin="0,0,8,0"/>
                                    <Button Command="{Binding SetThemeCommand}" CommandParameter="dark" Content="Dark" Width="110"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Brightness" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat={}{0}%}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider Minimum="10" Maximum="100" TickFrequency="5" Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,2"/>
                                <TextBlock Style="{StaticResource Muted}" Text="Preview updates are not written to flash; only the final value is persisted." FontSize="12"/>
                                <TextBlock Text="Default app on startup" FontWeight="SemiBold" Margin="0,18,0,7"/>
                                <ComboBox ItemsSource="{Binding DefaultAppOptions}" ItemTemplate="{StaticResource ComboLabelTemplate}" SelectedValuePath="Value" SelectedValue="{Binding DefaultApp}" IsEnabled="{Binding SupportsDefaultApp}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel IsEnabled="{Binding SupportsSettings}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Now Playing"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Layout" FontWeight="SemiBold" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding LayoutOptions}" ItemTemplate="{StaticResource ComboLabelTemplate}" SelectedValuePath="Value" SelectedValue="{Binding NowPlayingLayout}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Background" FontWeight="SemiBold" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding BackgroundOptions}" ItemTemplate="{StaticResource ComboLabelTemplate}" SelectedValuePath="Value" SelectedValue="{Binding NowPlayingBackground}"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Clock"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel IsEnabled="{Binding SupportsClockFormat}"><TextBlock Text="Time format" FontWeight="SemiBold" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding ClockFormatOptions}" ItemTemplate="{StaticResource ComboLabelTemplate}" SelectedValuePath="Value" SelectedValue="{Binding ClockFormat}"/></StackPanel>
                                    <StackPanel Grid.Column="2" IsEnabled="{Binding SupportsTimezone}"><TextBlock Text="Timezone" FontWeight="SemiBold" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding TimezoneOptions}" ItemTemplate="{StaticResource ComboLabelTemplate}" SelectedValuePath="Value" SelectedValue="{Binding Timezone}"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Codex Usage"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel IsEnabled="{Binding SupportsCodexPercentageMode}"><TextBlock Text="Percentage display" FontWeight="SemiBold" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding CodexPercentageModeOptions}" ItemTemplate="{StaticResource ComboLabelTemplate}" SelectedValuePath="Value" SelectedValue="{Binding CodexPercentageMode}"/></StackPanel>
                                    <StackPanel Grid.Column="2" IsEnabled="{Binding SupportsCodexPreferredDisplay}"><TextBlock Text="Preferred usage display" FontWeight="SemiBold" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding CodexPreferredDisplayOptions}" ItemTemplate="{StaticResource ComboLabelTemplate}" SelectedValuePath="Value" SelectedValue="{Binding CodexPreferredDisplay}"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel IsEnabled="{Binding SupportsPerformanceDefaultView}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Performance"/>
                                <TextBlock Text="Default view" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                <ComboBox ItemsSource="{Binding PerformanceDefaultViewOptions}" ItemTemplate="{StaticResource ComboLabelTemplate}" SelectedValuePath="Value" SelectedValue="{Binding PerformanceDefaultView}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Muted}" Text="A control is disabled only when the connected EchoDesk OS explicitly reports that setting as unsupported." TextWrapping="Wrap" Margin="4,0,0,14"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Desktop app"/>
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="Desktop appearance" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding AppearanceOptions}" SelectedItem="{Binding DesktopAppearance}"/></Grid>
                                <CheckBox Content="Minimise to the system tray when the window closes" IsChecked="{Binding MinimizeToTray}"/>
                                <CheckBox Content="Launch EchoDesk Desktop with Windows" IsChecked="{Binding LaunchWithWindows}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,11">
                <TextBlock Text="{Binding Feedback}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Grid>
</Window>
