<Window x:Class="EchoDesk.Desktop.ClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EchoDesk Clock" Width="520" Height="390" MinWidth="480" MinHeight="340"
        SizeToContent="Height" MaxHeight="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="EchoDesk Clock configuration">
    <Grid Margin="26">
        <StackPanel>
            <TextBlock x:Name="WindowHeading" Text="Clock" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock x:Name="WindowSubheading" Text="Choose a timer for your EchoDesk Mini." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,20"/>

            <Border x:Name="StopwatchPanel" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Stopwatch" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StopwatchDisplay}" FontSize="38" FontWeight="Light" FontFamily="Consolas" Margin="0,12,0,14"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ClockActionCommand}" CommandParameter="stopwatch:start" Content="Start" Margin="0,0,8,8"/>
                        <Button Command="{Binding ClockActionCommand}" CommandParameter="stopwatch:pause" Content="Pause" Margin="0,0,8,8"/>
                        <Button Command="{Binding ClockActionCommand}" CommandParameter="stopwatch:reset" Content="Reset" Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="CountdownPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="How long?" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Enter the countdown duration, then send it to EchoDesk." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Minutes" FontWeight="SemiBold"/><TextBox Text="{Binding CountdownDurationMinutes, UpdateSourceTrigger=PropertyChanged}" MinHeight="42" Padding="12,8" Margin="0,6,0,0" AutomationProperties.Name="Countdown minutes"/></StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Cancel" MinWidth="82" Margin="0,0,8,0" Click="Close_Click" IsCancel="True"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Done" MinWidth="92" Click="CountdownDone_Click" IsDefault="True"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="FocusPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Plan a focus session" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Choose the work and break rhythm for EchoDesk." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Focus minutes" FontWeight="SemiBold"/><TextBox Text="{Binding FocusDurationMinutes, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="10,7" Margin="0,6,0,0" AutomationProperties.Name="Focus minutes"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Break minutes" FontWeight="SemiBold"/><TextBox Text="{Binding FocusBreakMinutes, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="10,7" Margin="0,6,0,0" AutomationProperties.Name="Break minutes"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Rounds" FontWeight="SemiBold"/><TextBox Text="{Binding FocusRounds, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="10,7" Margin="0,6,0,0" AutomationProperties.Name="Focus rounds"/></StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancel" MinWidth="82" Margin="0,0,8,0" Click="Close_Click" IsCancel="True"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Done" MinWidth="92" Click="FocusDone_Click" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
