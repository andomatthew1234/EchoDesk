.pio/
.vscode/
.DS_Store
*.swp
*.swo
*~
__pycache__/

# Installer binary (built locally or by CI)
installer/bin/*.bin

# Sicherungskopie, die die S3-Plattform (pioarduino) bei jedem Build anlegt
src/idf_component.yml.orig

# Mac companion app build output
companion/build/

# Hardware-Test: Artefakte des IDF-Builds (werden neu erzeugt)
hardware-test/**/.dummy/
hardware-test/**/managed_components/
hardware-test/**/dependencies.lock
hardware-test/**/sdkconfig*

# EchoDesk Desktop build intermediates and local distributables. Release
# packages belong in GitHub Releases, not the source repository.
desktop/**/bin/
desktop/**/obj/
/desktop/dist/

# .NET helper build products and local validation output
/companion-windows/tools/**/bin/
/companion-windows/tools/**/obj/
/test-results/

# S3-Firmware: Artefakte des IDF-Builds im Projektwurzelverzeichnis
# (custom_sdkconfig in platformio.ini, werden bei jedem Build neu erzeugt)
/.dummy/
/managed_components/
/dependencies.lock
/CMakeLists.txt
/sdkconfig.*
/sdkconfig.defaults
